generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TUTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  FAILED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum TutorRequest {
  PENDING
  ACCEPTED
  CANCELLED
}

model User {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  fullName           String?      @default("")
  email              String       @unique
  phoneNumber        String?      @default("")
  password           String
  gender             String?      @default("")
  city               String?      @default("")
  status             UserStatus   @default(ACTIVE)
  fcmToken           String?      @default("")
  profileImage       String?      @default("")
  hourlyRate         Float?       @default(0.0)
  demoClassUrl       String?      @default("")
  isTutorRequest     Boolean      @default(false)
  isTutorApproved    Boolean      @default(false)
  tutorRequestStatus TutorRequest @default(PENDING)
  otp                Int?
  otpExpiresAt       DateTime?    @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  role               UserRole     @default(STUDENT)

  // Tutor-specific fields merged into User model:
  subject       String[] @default([]) // Subjects tutor can teach, empty array if not a tutor
  education     String?  @default("") // University or degree info
  experience    Int? // Years of teaching experience
  about         String? // Short description about the tutor
  availableDays String[] @default([]) // Days tutor is available
  availableTime String[] @default([]) // Time slots tutor is available
  rating        Float?   @default(0.0)
  totalReviews  Int?     @default(0)

  // Relations for chat, rooms, reviews, notifications:
  roomsSent             Room[]         @relation("SenderRelation")
  roomsReceived         Room[]         @relation("ReceiverRelation")
  chatsSent             Chat[]         @relation("SenderRelation")
  chatsReceived         Chat[]         @relation("ReceiverRelation")
  notificationsSent     Notification[] @relation("Sender")
  notificationsReceived Notification[] @relation("Receiver")

  // Payments related to user as tutor:
  tutorPayments Payment[] @relation("TutorPayments")

  // Bookings where user is tutor or student:
  tutorBookings   Booking[]    @relation("TutorBookings")
  studentBookings Booking[]    @relation("StudentBookings")
  savedStudent    SavedTutor[] @relation("SavedTutorStudent")
  savedTutor      SavedTutor[] @relation("SavedTutorTutor")

  //reviews where user is student or tutor:
  studentReviewes Review[] @relation("ReviewerStudent")
  tutorReview     Review[] @relation("ReviewTutor")

  // 
  warningsReceived Warning[] @relation("WarningUser")
  warningsGiven    Warning[] @relation("WarningAdmin")
}

model SavedTutor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation("SavedTutorStudent", fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String @db.ObjectId
  tutor   User   @relation("SavedTutorTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([studentId, tutorId])
}

model Payment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  studentID      String?       @default("") //sender
  tutorID        String        @db.ObjectId // reciver
  amountPaid     Float?        @default(0)
  paymentMethod  String?       @default("")
  paymentStatus  PaymentStatus @default(PENDING)
  paymentDate    DateTime      @default(now())
  paymentGateway String?       @default("")
  transactionId  String?       @default("")
  invoice_pdf    String?       @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Tutor relation
  tutor User @relation("TutorPayments", fields: [tutorID], references: [id])

  // Booking relation (foreign key is stored here)
  bookingId String  @unique @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  tutorId        String        @db.ObjectId
  studentId      String        @db.ObjectId
  subject        String        @default("")
  totalAmount   Float
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  bookingsStatus BookingStatus @default(PENDING)
  // isAccepted     Boolean       @default(false)
  // isPaymentDone  Boolean       @default(false)
  paymentStatus     PaymentStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // Relations to users acting as tutor and student:
  tutor          User          @relation("TutorBookings", fields: [tutorId], references: [id])
  student        User          @relation("StudentBookings", fields: [studentId], references: [id])
  Payment        Payment?
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User   @relation("SenderRelation", fields: [senderId], references: [id])
  receiver User   @relation("ReceiverRelation", fields: [receiverId], references: [id])
  chat     Chat[]

  @@map("rooms")
}

model Chat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  roomId     String   @db.ObjectId
  message    String
  images     String[]
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SenderRelation", fields: [senderId], references: [id])
  receiver User @relation("ReceiverRelation", fields: [receiverId], references: [id])
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("chats")
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String   @db.ObjectId
  senderId   String   @db.ObjectId
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  title      String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

model Review {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation("ReviewerStudent", fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String @db.ObjectId
  tutor   User   @relation("ReviewTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  rating    Int      @default(0)
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Warning {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation("WarningUser", fields: [userId], references: [id], onDelete: Cascade)

  adminId String @db.ObjectId
  admin   User   @relation("WarningAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  message   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warnings")
}
