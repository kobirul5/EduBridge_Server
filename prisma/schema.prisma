generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TUTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  FAILED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum TutorRequest {
  PENDING
  ACCEPTED
  CANCELLED
}

enum NotificationType {
  GENERAL
  REMINDER
  BOOKING
  PAYMENT
}

model User {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  fullName           String?      @default("")
  email              String       @unique
  phoneNumber        String?      @default("")
  password           String
  gender             String?      @default("")
  city               String?      @default("")
  status             UserStatus   @default(ACTIVE)
  fcmToken           String?      @default("")
  isOnline           Boolean?     @default(false)
  profileImage       String?      @default("")
  hourlyRate         Float?       @default(0.0)
  demoClassUrl       String?      @default("")
  isTutorRequest     Boolean      @default(false)
  isTutorApproved    Boolean      @default(false)
  tutorRequestStatus TutorRequest @default(PENDING)
  otp                Int?
  otpExpiresAt       DateTime?    @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  role               UserRole     @default(STUDENT)

  subject       String[] @default([])
  education     String?  @default("")
  experience    Int?
  about         String?
  availableDays String[] @default([])
  availableTime String[] @default([])
  rating        Float?   @default(0.0)
  totalReviews  Int?     @default(0)

  roomsSent       Room[]         @relation("SenderRelation")
  roomsReceived   Room[]         @relation("ReceiverRelation")
  chatsSent       Chat[]         @relation("SenderRelation")
  chatsReceived   Chat[]         @relation("ReceiverRelation")

  tutorPayments   Payment[] @relation("TutorPayments")
  studentPayments Payment[] @relation("StudentPayments")

  tutorBookings   Booking[]    @relation("TutorBookings")
  studentBookings Booking[]    @relation("StudentBookings")
  savedStudent    SavedTutor[] @relation("SavedTutorStudent")
  savedTutor      SavedTutor[] @relation("SavedTutorTutor")

  studentReviewes Review[] @relation("ReviewerStudent")
  tutorReview     Review[] @relation("ReviewTutor")

  notifications Notification[]

  warningsReceived Warning[] @relation("WarningUser")
  warningsGiven    Warning[] @relation("WarningAdmin")
}

model SavedTutor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation("SavedTutorStudent", fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String @db.ObjectId
  tutor   User   @relation("SavedTutorTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([studentId, tutorId])
}

model Payment {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId

  studentID String? @db.ObjectId
  student   User?   @relation("StudentPayments", fields: [studentID], references: [id], onDelete: Cascade)

  tutorID        String        @db.ObjectId
  amountPaid     Float?        @default(0)
  paymentMethod  String?       @default("")
  paymentStatus  PaymentStatus @default(PENDING)
  paymentDate    DateTime      @default(now())
  paymentGateway String?       @default("")
  transactionId  String?       @default("")
  invoice_pdf    String?       @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tutor User @relation("TutorPayments", fields: [tutorID], references: [id], onDelete: Cascade)

  bookingId String  @unique @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  tutorId        String        @db.ObjectId
  studentId      String        @db.ObjectId
  subject        String        @default("")
  totalAmount    Float
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  bookingsStatus BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tutor   User @relation("TutorBookings", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)

  Payment Payment?
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SenderRelation", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverRelation", fields: [receiverId], references: [id], onDelete: Cascade)
  chat     Chat[]

  @@map("rooms")
}

model Chat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  roomId     String   @db.ObjectId
  message    String
  images     String[]
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SenderRelation", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverRelation", fields: [receiverId], references: [id], onDelete: Cascade)
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("chats")
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  data      String?
  targetId  String?          @default("")
  slug      String?          @default("")
  fcmToken  String?          @default("")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  student   User   @relation("ReviewerStudent", fields: [studentId], references: [id], onDelete: Cascade)

  tutorId String @db.ObjectId
  tutor   User   @relation("ReviewTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  rating    Int      @default(0)
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Warning {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation("WarningUser", fields: [userId], references: [id], onDelete: Cascade)

  adminId String @db.ObjectId
  admin   User   @relation("WarningAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  message   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warnings")
}


















